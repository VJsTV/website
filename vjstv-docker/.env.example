STREAM_KEY_1=xxxx-xxxx-xxxx-xxxx-xxxx
STREAM_KEY_2=yyyy-yyyy-yyyy-yyyy-yyyy
STREAM_KEY_3=zzzz-zzzz-zzzz-zzzz-zzzz

TZ=UTC

# Signing key for schedule.json and channel playlists.
# Generate: openssl rand -hex 32
# Sign schedule: SCHEDULE_SIGNING_KEY=<key> node scripts/sign-schedule.js
SCHEDULE_SIGNING_KEY=

# Shared HMAC secret for authenticating heartbeat POSTs to the Pages Function.
# Generate: openssl rand -hex 32
HEARTBEAT_SECRET=

# Full URL of the Cloudflare Pages heartbeat endpoint.
HEARTBEAT_ENDPOINT=https://vjstv.com/api/stream/heartbeat
